### Specific to building Armbian ###
/.vagrant/
ubuntu-*-cloudimg-console.log

### to ignore changes in a working copy
.ignore_changes

### compile configurations added by users
/config-*.conf
### but not default (supplied) files
!/config-docker.conf
!/config-vagrant.conf

### output directories
/.tmp/
/output/
/cache/
/*userpatches*/
/userpatches
# Track board userpatch templates (rest of userpatches/ stays ignored)
!/userpatches/
!/userpatches/config/
!/userpatches/config/boards/
!/userpatches/config/boards/include/
!/userpatches/config/boards/include/orangepi5-family.conf
!/userpatches/config/boards/include/a7z-family.conf
!/userpatches/config/boards/orangepi5.conf
!/userpatches/config/boards/orangepi5-plus.conf
!/userpatches/config/boards/orangepi5b.csc
!/userpatches/config/boards/orangepi5-max.csc
!/userpatches/config/boards/orangepi5-ultra.csc
!/userpatches/config/boards/orangepi5pro.csc
!/userpatches/config/boards/radxa-cubie-a7z.csc
!/userpatches/config/boards/radxa-cubie-a7z-ufs.csc

### General annoyances ###
.DS_Store
*~
*.swp
**/__pycache__/

# Mainly generated by merge tools like 'meld'
*.orig

# Dockerfile and .dockerignore is generated by docker.sh
Dockerfile
.dockerignore

# Overlay files tracked in git
!/userpatches/overlay/
!/userpatches/overlay/authorized_keys
!/userpatches/overlay/wfb-ng/
!/userpatches/overlay/wfb-ng/README.md

# Build artifact: copied from gpio-service/ by build.sh
userpatches/overlay/gpio-service/

# Cached driver artifacts (binary, local-only)
userpatches/overlay/wfb-ng/*.ko

# Seeded from config/templates; keep local copies private (must be after userpatches/ un-ignore rules)
userpatches/customize-image.sh
userpatches/config-example.conf
