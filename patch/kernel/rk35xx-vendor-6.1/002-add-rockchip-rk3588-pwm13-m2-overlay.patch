From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Armbian Build System <patching@armbian.com>
Date: Thu, 27 Mar 2026 00:00:00 +0000
Subject: Add rockchip-rk3588-pwm13-m2 overlay matching OVERLAY_PREFIX

Vendor kernel ships PWM overlays with the rk3588- prefix, but the
Armbian overlay_prefix for this family is rockchip-rk3588. This adds
a rockchip-rk3588-pwm13-m2 overlay so that overlays=pwm13-m2 in
armbianEnv.txt resolves correctly on vendor kernel images.
---
 .../overlay/rockchip-rk3588-pwm13-m2.dts     | 13 +++++++++++++
 .../boot/dts/rockchip/overlay/Makefile        |  1 +
 2 files changed, 14 insertions(+)
 create mode 100644 arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm13-m2.dts

diff --git a/arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm13-m2.dts b/arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm13-m2.dts
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-pwm13-m2.dts
@@ -0,0 +1,13 @@
+/dts-v1/;
+/plugin/;
+
+/ {
+	fragment@0 {
+		target = <&pwm13>;
+
+		__overlay__ {
+			status = "okay";
+			pinctrl-0 = <&pwm13m2_pins>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/rockchip/overlay/Makefile b/arch/arm64/boot/dts/rockchip/overlay/Makefile
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/overlay/Makefile
+++ b/arch/arm64/boot/dts/rockchip/overlay/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 dtbo-$(CONFIG_ARCH_ROCKCHIP) += \
+	rockchip-rk3588-pwm13-m2.dtbo \
 	armsom-cm5-io-camera-imx219-cs0.dtbo \
 	armsom-cm5-io-camera-ov13850-cs1.dtbo \
 	armsom-cm5-io-display-10hd.dtbo \
-- 
Armbian

